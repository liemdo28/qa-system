{
  "name": "qa-system",
  "version": "1.0.0",
  "description": "Internal QA Department Automation System",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "qa": "ts-node src/index.ts",
    "qa:fast": "ts-node src/index.ts --levels source,build",
    "qa:ui": "ts-node src/index.ts --levels ui,role",
    "qa:stress": "ts-node src/index.ts --levels stress",
    "report": "ts-node src/index.ts --report-only",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Run: npm run qa\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "chalk": "^4.1.2",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.4",
    "playwright": "^1.59.1",
    "simple-git": "^3.36.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.6.0"
  }
}
